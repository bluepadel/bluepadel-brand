{
  "name": "@wardandpartners/bluepadel-brand",
  "version": "0.1.0",
  "description": "BluePadel brand tokens, Tailwind preset, and logo assets — single source of truth for the BluePadel visual identity.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind.preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.js",
      "require": "./dist/tailwind.preset.cjs"
    },
    "./variables.css": "./dist/variables.css",
    "./reset.css": "./dist/reset.css",
    "./assets/*": "./assets/*"
  },
  "files": ["dist/**", "assets/**", "README.md"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardandpartners/bluepadel-brand.git"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  }
}
